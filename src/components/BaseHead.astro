---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/red_flags_hero.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = FallbackImage,
	type = 'website',
	pubDate,
	updatedDate,
	jsonLd,
} = Astro.props;

const ogImageURL = new URL(image.src, Astro.site ?? Astro.url);
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="DisclosurePro AI" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
{type === 'article' && pubDate && (
	<meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === 'article' && updatedDate && (
	<meta property="article:modified_time" content={updatedDate.toISOString()} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Structured Data (JSON-LD) -->
{schemas.map((schema) => (
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<!-- Google tag (gtag.js) + Key Event Conversion Tracking -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-V1WBFNJ3ZT"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-V1WBFNJ3ZT');

  document.addEventListener('click', function (e) {
    var link = e.target && e.target.closest ? e.target.closest('a, button[data-gtag-event]') : null;
    if (!link || typeof gtag !== 'function') return;

    var customEvent = link.getAttribute('data-gtag-event');
    var customLabel = link.getAttribute('data-gtag-label') || window.location.pathname;
    var href = link.getAttribute('href') || '';

    if (customEvent) {
      gtag('event', customEvent, {
        event_category: 'conversion',
        event_label: customLabel,
        source_page: window.location.pathname
      });
    } else if (href.indexOf('play.google.com') !== -1) {
      gtag('event', 'play_store_click', {
        event_category: 'conversion',
        source_page: window.location.pathname
      });
    } else if (href === '/download' && link.closest('article')) {
      gtag('event', 'blog_cta_click', {
        event_category: 'conversion',
        source_page: window.location.pathname
      });
    } else if (href.indexOf('mailto:contact@disclosurepro.ai') === 0) {
      gtag('event', 'early_access_or_contact_click', {
        event_category: 'conversion',
        source_page: window.location.pathname
      });
    }
  });
</script>
