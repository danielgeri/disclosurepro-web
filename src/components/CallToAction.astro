<div class="cta-container">
	<div class="cta-content">
		<h2>Protect Your Investment with DisclosurePro AI</h2>
		<p>
			Don't rely on a hasty, manual read-through to protect your life savings.
			Upload your 100+ page disclosure packet, and our advanced AI will scan the
			entire document in seconds to find hidden structural red flags, unpermitted
			work, and pest damage.
		</p>
		<div class="cta-actions">
			<a href="/download" class="cta-button">
				Try DisclosurePro AI Free Today
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
			</a>
		</div>
	</div>
</div>

<style>
	.cta-container {
		margin: 4rem auto 2rem;
		border-radius: 16px;
		background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
		color: white;
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
		position: relative;
		overflow: hidden;
	}
	
	.cta-container::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(90deg, #3b82f6, #10b981);
	}

	.cta-content {
		padding: 3rem 2.5rem;
		text-align: center;
	}

	.cta-content h2 {
		color: white;
		margin-top: 0;
		margin-bottom: 1rem;
		font-size: 1.8rem;
		font-weight: 800;
		line-height: 1.2;
	}

	.cta-content p {
		color: #94a3b8;
		font-size: 1.1rem;
		line-height: 1.6;
		margin-bottom: 2rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
		color: white;
		font-weight: 700;
		font-size: 1.1rem;
		padding: 1rem 2rem;
		border-radius: 9999px;
		text-decoration: none;
		transition: all 0.2s ease;
		box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.4);
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.5);
		background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
		text-decoration: none;
	}
	
	.cta-button svg {
		transition: transform 0.2s ease;
	}
	
	.cta-button:hover svg {
		transform: translateX(4px);
	}

	@media (max-width: 640px) {
		.cta-content {
			padding: 2rem 1.5rem;
		}
		.cta-content h2 {
			font-size: 1.5rem;
		}
		.cta-button {
			width: 100%;
			padding: 0.875rem 1.5rem;
		}
	}
</style>
