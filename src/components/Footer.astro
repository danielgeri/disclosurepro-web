---
const today = new Date();
---

<footer class="footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<div class="brand-logo">
				<div class="logo-icon">DP</div>
				<span class="brand-name">DisclosurePro<span class="brand-ai">AI</span></span>
			</div>
			<p class="tagline">AI-powered property disclosure analysis, risk scoring, repair credit estimation, and automated addendums in seconds.</p>
		</div>

		<div class="footer-links-col">
			<h4>Product</h4>
			<a href="/#features">Features</a>
			<a href="/#pricing">Pricing Tiers</a>
			<a href="/#demo">Live Demo</a>
		</div>

		<div class="footer-links-col">
			<h4>Resources</h4>
			<a href="/blog">Real Estate Blog</a>
			<a href="/privacy">Privacy Policy</a>
			<a href="mailto:contact@disclosurepro.ai">Support & Feedback</a>
		</div>
	</div>

	<div class="container footer-bottom">
		<p>&copy; {today.getFullYear()} DisclosurePro AI. All rights reserved.</p>
		<p>Contact: <a href="mailto:contact@disclosurepro.ai">contact@disclosurepro.ai</a></p>
	</div>
</footer>

<style>
	.footer {
		background: #040711;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding: 60px 0 30px 0;
		margin-top: 80px;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 40px;
		margin-bottom: 40px;
	}
	.brand-logo {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 12px;
	}
	.logo-icon {
		background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
		color: #070b19;
		font-weight: 900;
		font-size: 14px;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.brand-name {
		color: #f8fafc;
		font-size: 18px;
		font-weight: 800;
	}
	.brand-ai {
		color: #00f2fe;
		font-size: 13px;
		font-weight: 900;
		margin-left: 4px;
	}
	.tagline {
		color: #64748b;
		font-size: 13px;
		max-width: 380px;
		line-height: 1.5;
	}
	.footer-links-col h4 {
		color: #f8fafc;
		font-size: 14px;
		font-weight: 700;
		margin-bottom: 16px;
	}
	.footer-links-col a {
		display: block;
		color: #94a3b8;
		font-size: 13px;
		margin-bottom: 10px;
		text-decoration: none;
	}
	.footer-links-col a:hover {
		color: #00f2fe;
	}
	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 24px;
		display: flex;
		justify-content: space-between;
		color: #475569;
		font-size: 12px;
	}
	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.footer-bottom {
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
