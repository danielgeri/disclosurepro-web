---
const today = new Date();
---

<footer class="footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<div class="brand-logo">
				<img
					src="/logo.webp"
					alt="DisclosurePro AI logo"
					width="32"
					height="32"
					loading="lazy"
					class="logo-icon-svg"
				/>
				<span class="brand-name">DisclosurePro</span>
			</div>
			<p class="tagline">AI-powered property disclosure analysis, home inspection review, risk scoring, repair credit estimation, and automated addendums in seconds.</p>
		</div>

		<div class="footer-links-col">
			<h4>Product</h4>
			<a href="/#features">Features</a>
			<a href="/#pricing">Pricing Tiers</a>
			<a href="/#demo">Live Demo</a>
			<a href="/download">Download App</a>
			<a href="/about">About DisclosurePro</a>
		</div>

		<div class="footer-links-col">
			<h4>Popular Guides</h4>
			<a href="/blog/california-tds-spq-disclosure-guide/">California TDS &amp; SPQ Guide</a>
			<a href="/blog/texas-trec-sellers-disclosure-guide/">Texas Seller's Disclosure (OP-H)</a>
			<a href="/blog/hoa-reserve-study-special-assessment-red-flags/">HOA Reserve Study Red Flags</a>
			<a href="/blog/5-disclosure-red-flags/">Top 5 Disclosure Red Flags</a>
			<a href="/blog">All Buyer Guides &rarr;</a>
		</div>

		<div class="footer-links-col">
			<h4>Legal &amp; Support</h4>
			<a href="/terms">Terms of Service</a>
			<a href="/privacy">Privacy Policy</a>
			<a href="/delete">Data Deletion</a>
			<a href="mailto:contact@disclosurepro.ai">Support &amp; Feedback</a>
		</div>
	</div>

	<div class="container footer-bottom">
		<p>&copy; {today.getFullYear()} DisclosurePro AI. All rights reserved.</p>
		<p>Contact: <a href="mailto:contact@disclosurepro.ai">contact@disclosurepro.ai</a></p>
	</div>
</footer>

<style>
	.footer {
		background: var(--footer-bg);
		border-top: 1px solid var(--footer-border);
		padding: 60px 0 30px 0;
		margin-top: 80px;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 1.8fr 1fr 1.3fr 1fr;
		gap: 36px;
		margin-bottom: 40px;
	}
	.brand-logo {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 12px;
	}
	.logo-icon-svg {
		height: 32px;
		width: 32px;
		border-radius: 7px;
		object-fit: cover;
	}
	.brand-name {
		color: var(--text-primary);
		font-size: 18px;
		font-weight: 800;
	}
	.tagline {
		color: var(--text-secondary);
		font-size: 13px;
		max-width: 340px;
		line-height: 1.55;
	}
	.footer-links-col h4 {
		color: var(--text-primary);
		font-size: 14px;
		font-weight: 700;
		margin-bottom: 16px;
	}
	.footer-links-col a {
		display: block;
		color: var(--text-secondary);
		font-size: 13px;
		margin-bottom: 10px;
		text-decoration: none;
	}
	.footer-links-col a:hover {
		color: var(--accent-cyan);
	}
	.footer-bottom {
		border-top: 1px solid var(--border-color);
		padding-top: 24px;
		display: flex;
		justify-content: space-between;
		color: var(--text-secondary);
		font-size: 12px;
	}
	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 600px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.footer-bottom {
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
