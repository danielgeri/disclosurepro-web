---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CallToAction from '../components/CallToAction.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	slug?: string;
};

const { title, description, pubDate, updatedDate, heroImage, slug } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const heroImageURL = heroImage
	? new URL(heroImage.src, Astro.site ?? Astro.url).toString()
	: 'https://www.disclosurepro.ai/logo.jpeg';

const cornerstoneGuides = [
	{
		id: 'california-tds-spq-disclosure-guide',
		title: 'How to Read a California Seller Disclosure Packet (TDS, SPQ, NHD & Section 1 Guide)',
		description:
			'Decode the California Transfer Disclosure Statement (TDS), SPQ, AVID, NHD report, and Section 1 vs. Section 2 termite findings before waiving contingencies.',
	},
	{
		id: 'texas-trec-sellers-disclosure-guide',
		title: "Texas Seller's Disclosure Notice (TREC OP-H): 7 Costly Red Flags Buyers Miss",
		description:
			'Spot foundation movement, unclosed hail roof claims, cast-iron slab drains, and MUD tax traps during your Texas Option Period.',
	},
	{
		id: 'hoa-reserve-study-special-assessment-red-flags',
		title: 'HOA Reserve Studies & Meeting Minutes: How to Spot $20,000+ Special Assessments',
		description:
			'Read Percent Funded scores, master insurance deductibles, and 12 months of HOA board minutes before your condo review contingency expires.',
	},
	{
		id: '5-disclosure-red-flags',
		title: '5 Seller Disclosure Red Flags Homebuyers Miss (And How AI Catches Them)',
		description:
			'Uncover vague seller caveats, Zinsco/FPE breaker panels, aging roofs, unpermitted work, and HOA litigation inside 100+ page PDF packets.',
	},
].filter((g) => g.id !== slug);

const articleSchemas = [
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: title,
		description: description,
		image: [heroImageURL],
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': canonicalURL,
		},
		author: {
			'@type': 'Organization',
			name: 'DisclosurePro Real Estate Research Team',
			url: 'https://www.disclosurepro.ai/about',
		},
		publisher: {
			'@type': 'Organization',
			name: 'DisclosurePro AI',
			logo: {
				'@type': 'ImageObject',
				url: 'https://www.disclosurepro.ai/logo.jpeg',
			},
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: 'https://www.disclosurepro.ai/',
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Guides & Blog',
				item: 'https://www.disclosurepro.ai/blog/',
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: title,
				item: canonicalURL,
			},
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
			jsonLd={articleSchemas}
		/>
		<style is:global>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0 auto;
			}
			.breadcrumbs {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 1.5rem auto 1rem auto;
				font-size: 14px;
				color: var(--text-secondary);
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				align-items: center;
			}
			.breadcrumbs a {
				color: var(--accent-blue);
				text-decoration: none;
				font-weight: 600;
			}
			.breadcrumbs a:hover {
				text-decoration: underline;
			}
			.hero-image {
				width: 100%;
				max-width: 1020px;
				margin: 0 auto;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--text-primary);
				text-wrap: pretty;
				font-size: 19px;
				line-height: 1.68;
			}
			.prose p {
				margin-bottom: 1.4em;
				color: #292929;
			}
			.prose h2,
			.prose h3,
			.prose h4 {
				color: #1e293b;
				font-weight: 800;
				line-height: 1.3;
				text-wrap: balance;
			}
			.prose h2 {
				font-size: 30px;
				margin-top: 2em;
				margin-bottom: 0.55em;
			}
			.prose h3 {
				font-size: 23px;
				margin-top: 1.5em;
				margin-bottom: 0.5em;
			}
			.prose ul,
			.prose ol {
				margin-bottom: 1.5em;
				padding-left: 1.5em;
				color: #292929;
			}
			.prose li {
				margin-bottom: 0.5em;
			}
			.prose blockquote {
				border-left: 3px solid var(--accent-blue);
				padding-left: 1.5em;
				margin-left: 0;
				margin-right: 0;
				font-style: italic;
				color: var(--text-secondary);
				margin-bottom: 1.5em;
			}
			.prose hr {
				margin: 1.5em auto;
				border: 0;
				text-align: center;
			}
			.prose hr::before {
				content: '...';
				font-size: 28px;
				letter-spacing: 0.6em;
				color: var(--text-secondary);
			}
			.title {
				margin-bottom: 1.8em;
				padding: 1em 0 0.5em 0;
				text-align: center;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0.35em 0 0.5em 0;
				color: var(--text-primary);
				text-wrap: balance;
				font-size: 38px;
				font-weight: 900;
				letter-spacing: -0.02em;
			}
			.meta-row {
				font-size: 15px;
				color: var(--text-secondary);
				display: flex;
				justify-content: center;
				gap: 10px;
				flex-wrap: wrap;
				align-items: center;
			}
			.last-updated-on {
				font-style: italic;
			}
			.related-section {
				width: 920px;
				max-width: calc(100% - 2em);
				margin: 2.5rem auto 1rem auto;
				padding-top: 2rem;
				border-top: 1px solid var(--border-color);
			}
			.related-section h2 {
				font-size: 24px;
				font-weight: 800;
				margin-bottom: 1.2rem;
				color: var(--text-primary);
			}
			.related-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 18px;
			}
			.related-card {
				background: #ffffff;
				border: 1px solid rgba(0, 0, 0, 0.1);
				border-radius: 14px;
				padding: 20px;
				text-decoration: none !important;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.related-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(13, 56, 112, 0.12);
			}
			.related-card h3 {
				font-size: 16px;
				font-weight: 700;
				color: #1e293b;
				line-height: 1.35;
				margin-bottom: 8px;
			}
			.related-card p {
				font-size: 13.5px;
				color: #475569;
				line-height: 1.5;
				margin-bottom: 12px;
			}
			.related-card span {
				font-size: 13px;
				font-weight: 700;
				color: var(--accent-blue);
			}
			@media (max-width: 640px) {
				.title h1 {
					font-size: 28px;
				}
				.prose {
					font-size: 17px;
				}
			}
		</style>
	</head>

	<body class="theme-light">
		<Header />
		<main>
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span aria-hidden="true">/</span>
				<a href="/blog">Guides &amp; Blog</a>
			</nav>

			<article>
				<div class="hero-image">
					{heroImage && (
						<Image
							width={1020}
							height={510}
							src={heroImage}
							alt={title}
							fetchpriority="high"
							loading="eager"
						/>
					)}
				</div>
				<div class="prose">
					<div class="title">
						<div class="meta-row">
							<span><FormattedDate date={pubDate} /></span>
							<span aria-hidden="true">•</span>
							<span>By <a href="/about">DisclosurePro Research Team</a></span>
							{updatedDate && (
								<div class="last-updated-on">
									(Updated <FormattedDate date={updatedDate} />)
								</div>
							)}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>

					<slot />
					<CallToAction />
				</div>
			</article>

			{cornerstoneGuides.length > 0 && (
				<section class="related-section" aria-label="Essential disclosure guides">
					<h2>Essential Homebuyer Disclosure &amp; Inspection Guides</h2>
					<div class="related-grid">
						{cornerstoneGuides.slice(0, 4).map((guide) => (
							<a href={`/blog/${guide.id}/`} class="related-card">
								<div>
									<h3>{guide.title}</h3>
									<p>{guide.description}</p>
								</div>
								<span>Read Guide &rarr;</span>
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
