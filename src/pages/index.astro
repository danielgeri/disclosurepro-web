---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const featuredSlugs = [
	'california-tds-spq-disclosure-guide',
	'texas-trec-sellers-disclosure-guide',
	'hoa-reserve-study-special-assessment-red-flags',
	'5-disclosure-red-flags',
];

const allPosts = await getCollection('blog');
const featuredGuides = featuredSlugs
	.map((slug) => allPosts.find((p) => p.id === slug))
	.filter((p): p is NonNullable<typeof p> => Boolean(p));

const homeSchemas = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'DisclosurePro AI',
		url: 'https://www.disclosurepro.ai',
		applicationCategory: 'BusinessApplication',
		operatingSystem: 'Android, iOS, Web',
		description: SITE_DESCRIPTION,
		downloadUrl: 'https://play.google.com/store/apps/details?id=ai.disclosurepro.app',
		offers: [
			{
				'@type': 'Offer',
				name: 'Free Plan',
				price: '0',
				priceCurrency: 'USD',
			},
			{
				'@type': 'Offer',
				name: 'Pro Plan',
				price: '29',
				priceCurrency: 'USD',
			},
			{
				'@type': 'Offer',
				name: 'Unlimited Plan',
				price: '79',
				priceCurrency: 'USD',
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: 'DisclosurePro AI',
		url: 'https://www.disclosurepro.ai',
		logo: 'https://www.disclosurepro.ai/logo.jpeg',
		contactPoint: {
			'@type': 'ContactPoint',
			email: 'contact@disclosurepro.ai',
			contactType: 'customer support',
		},
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} jsonLd={homeSchemas} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero-section">
				<div class="container hero-container">
					<div class="badge-tech">
						<span>✨ AI Seller Disclosure, Inspection &amp; HOA Analyzer</span>
					</div>
					<h1 class="hero-title">
						Uncover Costly Home Defects <span class="gradient-text">Before You Buy</span>
					</h1>
					<p class="hero-subtitle">
						AI-powered real estate disclosure analysis, home inspection review, HOA reserve scoring, repair credit calculations, and automated addendums in seconds.
					</p>

					<div class="hero-actions">
						<a
							href="/download"
							class="btn-primary"
							data-gtag-event="cta_download_click"
							data-gtag-label="hero_analyze_free"
						>
							<span>Analyze Your 1st Property Free</span>
							<span aria-hidden="true">📱</span>
						</a>
						<a
							href="#demo"
							class="btn-secondary"
							data-gtag-event="demo_explore_click"
							data-gtag-label="hero_explore_demo"
						>
							<span>See Sample AI Report</span>
							<span aria-hidden="true">🔍</span>
						</a>
					</div>

					<!-- Live Demo Preview Card -->
					<div id="demo" class="glass-card demo-card">
						<div class="demo-header">
							<div class="demo-property">
								<span class="property-icon" aria-hidden="true">🏠</span>
								<div>
									<h2 class="property-title">Sample Analysis: 772 Vincente Avenue, Berkeley, CA</h2>
									<span class="property-sub">124-Page Disclosure &amp; Inspection Packet • Analyzed in 8.2s</span>
								</div>
							</div>
							<div class="risk-badge risk-high">
								<span>78 / 100</span>
								<span class="risk-lbl">HIGH RISK</span>
							</div>
						</div>

						<div class="demo-metrics">
							<div class="metric-box">
								<span class="metric-label">Estimated Repair Credit</span>
								<span class="metric-val gradient-gold">$14,500 – $22,000</span>
							</div>
							<div class="metric-box">
								<span class="metric-label">Flagged Issues</span>
								<span class="metric-val">6 Critical Findings</span>
							</div>
							<div class="metric-box">
								<span class="metric-label">Source Verification</span>
								<span class="metric-val">Exact PDF Page Links</span>
							</div>
						</div>

						<div class="demo-findings">
							<div class="finding-item critical">
								<span class="f-rank">CRITICAL</span>
								<div class="f-info">
									<h3>Roofing System Active Water Leaks (p. 42)</h3>
									<p>"Water staining observed in attic rafters above primary bedroom. Roof shingles past useful lifespan (22+ years)."</p>
								</div>
								<span class="f-cost">$8,500 – $12,000</span>
							</div>
							<div class="finding-item high">
								<span class="f-rank">HIGH</span>
								<div class="f-info">
									<h3>Zinsco Main Electrical Service Panel (p. 67)</h3>
									<p>"Outdated Zinsco 125A panel present. Known circuit breaker failure hazard requiring full service replacement for insurance."</p>
								</div>
								<span class="f-cost">$3,500 – $5,500</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Features Section -->
			<section id="features" class="features-section">
				<div class="container">
					<div class="section-head text-center">
						<span class="badge-tech">Enterprise AI Architecture</span>
						<h2>Everything You Need for Bulletproof Real Estate Due Diligence</h2>
						<p>Built for homebuyers, buyer's agents, real estate investors, and transaction coordinators.</p>
					</div>

					<div class="features-grid">
						<div class="glass-card feature-box">
							<div class="f-icon" aria-hidden="true">⚡</div>
							<h3>Instant Risk Scoring</h3>
							<p>Scans 100+ page seller disclosures, home inspections, WDO reports, and HOA packets in under 10 seconds, scoring risk from Low to Critical.</p>
						</div>

						<div class="glass-card feature-box">
							<div class="f-icon" aria-hidden="true">🔍</div>
							<h3>PDF Citation Page Linker</h3>
							<p>Every extracted finding is mapped to its exact page number in the original PDF with 1-tap verification inside the app.</p>
						</div>

						<div class="glass-card feature-box">
							<div class="f-icon" aria-hidden="true">💰</div>
							<h3>Repair Credit Calculations</h3>
							<p>Itemized dollar estimates for roofing, electrical, plumbing, termite, and foundation defects to strengthen offer negotiations.</p>
						</div>

						<div class="glass-card feature-box">
							<div class="f-icon" aria-hidden="true">📑</div>
							<h3>Automated Addendum Exporter</h3>
							<p>Generate formal, ready-to-sign Purchase Agreement Credit Addendums formatted directly for sellers and listing agents.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Pricing Section -->
			<section id="pricing" class="pricing-section">
				<div class="container">
					<div class="section-head text-center">
						<span class="badge-tech">Transparent Membership Tiers</span>
						<h2>Choose the Plan That Fits Your Workflow</h2>
						<p>Start free with 1 full property report every month—upgrade anytime as you tour and bid on more homes.</p>
					</div>

					<div class="pricing-grid">
						<!-- Free -->
						<div class="glass-card plan-card">
							<div class="plan-head">
								<h3>Free Plan</h3>
								<div class="plan-price">$0 <span>/ month</span></div>
								<p>1 report / month</p>
							</div>
							<ul class="plan-features">
								<li>✓ 1 Property Analysis per month</li>
								<li>✓ Risk Score &amp; Finding Breakdown</li>
								<li>✓ PDF Page Citation Viewer</li>
							</ul>
							<a
								href="/download"
								class="btn-secondary w-full"
								data-gtag-event="cta_download_click"
								data-gtag-label="pricing_free"
							>
								Start Free
							</a>
						</div>

						<!-- Pro - Popular -->
						<div class="glass-card plan-card popular">
							<div class="popular-tag">MOST POPULAR</div>
							<div class="plan-head">
								<h3>Pro Plan</h3>
								<div class="plan-price">$29 <span>/ month</span></div>
								<p>10 reports / month</p>
							</div>
							<ul class="plan-features">
								<li>✓ 10 Property Analyses per month</li>
								<li>✓ Priority Advanced AI Deep Thinking</li>
								<li>✓ Instant AI Document Q&amp;A Assistant</li>
								<li>✓ Repair Cost Calculations</li>
							</ul>
							<a
								href="/download"
								class="btn-primary w-full"
								data-gtag-event="cta_download_click"
								data-gtag-label="pricing_pro"
							>
								Get Pro Plan
							</a>
						</div>

						<!-- Unlimited -->
						<div class="glass-card plan-card">
							<div class="plan-head">
								<h3>Unlimited Plan</h3>
								<div class="plan-price">$79 <span>/ month</span></div>
								<p>Unlimited reports</p>
							</div>
							<ul class="plan-features">
								<li>✓ Unlimited Property Analyses</li>
								<li>✓ Everything in Pro Plan</li>
								<li>✓ Purchase Addendum Exporting</li>
								<li>✓ Multi-Doc Upload Packages</li>
							</ul>
							<a
								href="/download"
								class="btn-secondary w-full"
								data-gtag-event="cta_download_click"
								data-gtag-label="pricing_unlimited"
							>
								Get Unlimited
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Featured Guides Section (Internal SEO Hub) -->
			{featuredGuides.length > 0 && (
				<section class="guides-section">
					<div class="container">
						<div class="section-head text-center">
							<span class="badge-tech">Homebuyer Due Diligence Library</span>
							<h2>Learn How to Spot Hidden Disclosure Traps</h2>
							<p>Practical state-by-state guides on seller disclosures, inspection reports, and HOA reserve studies.</p>
						</div>

						<div class="guides-grid">
							{featuredGuides.map((guide) => (
								<a href={`/blog/${guide.id}/`} class="glass-card guide-card">
									<h3>{guide.data.title}</h3>
									<p>{guide.data.description}</p>
									<span class="guide-read-more">Read Full Guide &rarr;</span>
								</a>
							))}
						</div>

						<div class="text-center" style="margin-top: 28px;">
							<a href="/blog" class="btn-secondary">Browse All Real Estate Guides &rarr;</a>
						</div>
					</div>
				</section>
			)}

			<!-- App Download Section -->
			<section id="download" class="download-section">
				<div class="container">
					<div class="glass-card download-card text-center">
						<h2>Ready to Analyze Disclosures with AI?</h2>
						<p>Get DisclosurePro AI on Google Play today, or request instant iPhone &amp; Desktop Web access.</p>
						<div class="download-buttons">
							<a
								href="https://play.google.com/store/apps/details?id=ai.disclosurepro.app"
								target="_blank"
								rel="noopener noreferrer"
								class="btn-primary"
								data-gtag-event="play_store_click"
								data-gtag-label="home_bottom_google_play"
							>
								Download on Google Play 🤖
							</a>
							<a
								href="mailto:contact@disclosurepro.ai?subject=iOS%20%26%20Web%20Early%20Access%20Invite"
								class="btn-secondary"
								data-gtag-event="early_access_click"
								data-gtag-label="home_bottom_ios_web_invite"
							>
								Request iOS &amp; Web Access 🌐
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Hero */
	.hero-section {
		padding: 80px 0 60px 0;
		text-align: center;
	}
	.hero-container {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.hero-title {
		font-size: 48px;
		font-weight: 900;
		line-height: 1.15;
		margin: 20px 0 16px 0;
		max-width: 800px;
		letter-spacing: -1px;
		text-wrap: balance;
	}
	.hero-subtitle {
		color: #94a3b8;
		font-size: 18px;
		max-width: 640px;
		margin-bottom: 32px;
		text-wrap: pretty;
	}
	.hero-actions {
		display: flex;
		gap: 16px;
		margin-bottom: 60px;
	}

	/* Demo Card */
	.demo-card {
		width: 100%;
		max-width: 900px;
		padding: 28px;
		text-align: left;
	}
	.demo-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 20px;
		margin-bottom: 20px;
		gap: 16px;
	}
	.demo-property {
		display: flex;
		gap: 14px;
		align-items: center;
	}
	.property-icon {
		font-size: 28px;
	}
	.property-title {
		font-size: 18px;
		color: #f8fafc;
		font-weight: 700;
	}
	.property-sub {
		font-size: 13px;
		color: #94a3b8;
	}
	.risk-badge {
		padding: 8px 16px;
		border-radius: 12px;
		text-align: center;
		font-weight: 900;
		flex-shrink: 0;
	}
	.risk-high {
		background: rgba(239, 68, 68, 0.15);
		border: 1px solid rgba(239, 68, 68, 0.4);
		color: #f87171;
	}
	.risk-lbl {
		display: block;
		font-size: 10px;
		font-weight: 700;
	}
	.demo-metrics {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 16px;
		margin-bottom: 24px;
	}
	.metric-box {
		background: rgba(255, 255, 255, 0.03);
		padding: 14px;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.05);
	}
	.metric-label {
		display: block;
		font-size: 12px;
		color: #94a3b8;
		margin-bottom: 4px;
	}
	.metric-val {
		font-size: 18px;
		font-weight: 800;
		color: #f8fafc;
	}

	.finding-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.05);
		margin-bottom: 10px;
	}
	.finding-item.critical { border-left: 4px solid #ef4444; }
	.finding-item.high { border-left: 4px solid #f59e0b; }
	.f-rank {
		font-size: 11px;
		font-weight: 900;
		padding: 4px 8px;
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.08);
	}
	.f-info { flex: 1; margin: 0 16px; }
	.f-info h3 { font-size: 14px; color: #f8fafc; margin-bottom: 2px; font-weight: 700; }
	.f-info p { font-size: 12px; color: #94a3b8; }
	.f-cost { font-size: 14px; font-weight: 800; color: #f59e0b; }

	/* Features */
	.features-section { padding: 80px 0; }
	.text-center { text-align: center; }
	.section-head h2 { font-size: 32px; font-weight: 800; margin: 16px 0 10px 0; text-wrap: balance; }
	.section-head p { color: #94a3b8; margin-bottom: 40px; }

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 24px;
	}
	.feature-box {
		padding: 28px;
	}
	.f-icon { font-size: 32px; margin-bottom: 16px; }
	.feature-box h3 { font-size: 18px; color: #f8fafc; margin-bottom: 8px; }
	.feature-box p { color: #94a3b8; font-size: 14px; line-height: 1.5; }

	/* Pricing */
	.pricing-section { padding: 60px 0; }
	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 28px;
		margin-top: 40px;
	}
	.plan-card {
		padding: 32px;
		position: relative;
		display: flex;
		flex-direction: column;
	}
	.plan-card.popular {
		border-color: #00f2fe;
		box-shadow: 0 10px 40px rgba(0, 242, 254, 0.2);
	}
	.popular-tag {
		position: absolute;
		top: -12px;
		right: 24px;
		background: var(--gradient-primary);
		color: #070b19;
		font-size: 11px;
		font-weight: 900;
		padding: 4px 12px;
		border-radius: 20px;
	}
	.plan-head h3 { font-size: 20px; color: #f8fafc; }
	.plan-price { font-size: 36px; font-weight: 900; color: #f8fafc; margin: 10px 0 4px 0; }
	.plan-price span { font-size: 14px; color: #94a3b8; font-weight: 400; }
	.plan-features { list-style: none; margin: 24px 0; flex: 1; }
	.plan-features li { color: #cbd5e1; font-size: 14px; margin-bottom: 10px; }
	.w-full { width: 100%; justify-content: center; }

	/* Featured Guides */
	.guides-section {
		padding: 60px 0 20px 0;
	}
	.guides-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 24px;
	}
	.guide-card {
		padding: 28px;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	.guide-card h3 {
		font-size: 18px;
		font-weight: 700;
		color: #f8fafc;
		line-height: 1.35;
		margin-bottom: 10px;
	}
	.guide-card p {
		font-size: 14px;
		color: #94a3b8;
		line-height: 1.55;
		margin-bottom: 16px;
		flex: 1;
	}
	.guide-read-more {
		font-size: 14px;
		font-weight: 700;
		color: var(--accent-cyan);
	}

	.download-section { padding: 60px 0 80px 0; }
	.download-card { padding: 48px; }
	.download-card p { color: #94a3b8; margin-top: 8px; }
	.download-buttons { display: flex; justify-content: center; gap: 16px; margin-top: 24px; flex-wrap: wrap; }

	@media (max-width: 768px) {
		.hero-title { font-size: 32px; }
		.demo-header { flex-direction: column; align-items: flex-start; }
		.demo-metrics { grid-template-columns: 1fr; }
		.finding-item { flex-direction: column; align-items: flex-start; gap: 8px; }
		.f-info { margin: 0; }
		.hero-actions { flex-direction: column; width: 100%; }
		.hero-actions a { justify-content: center; }
		.download-buttons { flex-direction: column; }
		.download-buttons a { justify-content: center; }
	}
</style>
