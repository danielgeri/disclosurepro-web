---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = `About DisclosurePro AI — Real Estate Document Intelligence`;
const pageDescription =
	'Learn how DisclosurePro AI helps homebuyers, real estate agents, and investors uncover hidden property defects, HOA assessments, and repair credits inside 100+ page disclosure packets.';

const aboutSchema = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	name: pageTitle,
	description: pageDescription,
	url: 'https://www.disclosurepro.ai/about',
	mainEntity: {
		'@type': 'Organization',
		name: 'DisclosurePro AI',
		url: 'https://www.disclosurepro.ai',
		logo: 'https://www.disclosurepro.ai/logo.jpeg',
		contactPoint: {
			'@type': 'ContactPoint',
			email: 'contact@disclosurepro.ai',
			contactType: 'customer support',
		},
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} jsonLd={aboutSchema} />
	</head>
	<body>
		<Header />
		<main class="container about-page">
			<section class="about-hero text-center">
				<span class="badge-tech">About DisclosurePro AI</span>
				<h1>Bringing Clarity to Every Real Estate Transaction</h1>
				<p class="lead">
					Homebuyers are routinely handed 100 to 500 pages of dense seller disclosures, home inspection reports, pest clearances, and HOA financial packets—with just days to make the largest financial decision of their lives. We built DisclosurePro AI so critical red flags never get buried in fine print.
				</p>
			</section>

			<section class="about-grid">
				<div class="glass-card about-card">
					<h2>Why We Built DisclosurePro</h2>
					<p>
						Most post-closing buyer regrets—$25,000 roof replacements, recalled electrical panels, foundation movement, or surprise HOA special assessments—were actually mentioned somewhere inside the disclosure packet. They were simply buried on page 84 in passive, technical, or handwritten language.
					</p>
					<p>
						DisclosurePro AI combines multi-document reasoning with direct PDF page citations so homebuyers, agents, and investors can verify every finding directly against the source document in seconds.
					</p>
				</div>

				<div class="glass-card about-card">
					<h2>How Our Document Analysis Works</h2>
					<ul>
						<li><strong>Multi-Document Cross-Checking:</strong> Simultaneously scans Seller Disclosures (TDS, SPQ, TREC OP-H, PCDS), Home Inspections, WDO/Termite Reports, NHD Reports, and HOA Reserve Studies.</li>
						<li><strong>Verifiable Page Citations:</strong> Every flagged risk links directly to the exact PDF page number—eliminating guesswork and hallucinations.</li>
						<li><strong>Actionable Repair Estimates:</strong> Translates technical findings into realistic repair cost ranges and ready-to-export Purchase Agreement Credit Addendums.</li>
					</ul>
				</div>
			</section>

			<section class="glass-card editorial-box">
				<h2>Editorial Standards &amp; Legal Disclaimer</h2>
				<p>
					Our educational guides are researched and maintained by the <strong>DisclosurePro Real Estate Research Team</strong> using publicly available state statutes, standardized real estate commission forms, and building inspection standards.
				</p>
				<p>
					<strong>Important Notice:</strong> DisclosurePro AI is an informational document-analysis software platform—not a law firm, licensed real estate brokerage, or structural engineering firm. Nothing on this website or inside the application constitutes legal advice or a physical property inspection. Always consult a qualified real estate attorney, licensed agent, and certified inspector in your jurisdiction before waiving contingencies.
				</p>
			</section>

			<section class="glass-card cta-box text-center">
				<h2>Have Questions or Partnership Inquiries?</h2>
				<p>
					Whether you are a first-time homebuyer, an active buyer's agent, or a brokerage transaction coordinator, we would love to hear from you.
				</p>
				<div class="cta-actions">
					<a
						href="/download"
						class="btn-primary"
						data-gtag-event="cta_download_click"
						data-gtag-label="about_page_try_free"
					>
						Try DisclosurePro AI Free 🚀
					</a>
					<a href="mailto:contact@disclosurepro.ai" class="btn-secondary">
						Email contact@disclosurepro.ai
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page {
		padding-top: 64px;
		padding-bottom: 40px;
	}
	.text-center {
		text-align: center;
	}
	.about-hero {
		max-width: 820px;
		margin: 0 auto 48px auto;
	}
	h1 {
		font-size: 42px;
		font-weight: 900;
		line-height: 1.15;
		margin: 18px 0 16px 0;
		letter-spacing: -0.8px;
		text-wrap: balance;
	}
	.lead {
		color: var(--text-secondary);
		font-size: 18px;
		line-height: 1.65;
		text-wrap: pretty;
	}
	.about-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		margin-bottom: 24px;
	}
	.about-card,
	.editorial-box,
	.cta-box {
		padding: 36px;
		margin-bottom: 24px;
	}
	h2 {
		font-size: 22px;
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 14px;
	}
	p,
	li {
		color: var(--text-secondary);
		font-size: 15px;
		line-height: 1.65;
		margin-bottom: 12px;
	}
	ul {
		padding-left: 20px;
	}
	li strong {
		color: var(--text-primary);
	}
	.cta-actions {
		display: flex;
		justify-content: center;
		gap: 16px;
		margin-top: 20px;
		flex-wrap: wrap;
	}
	@media (max-width: 768px) {
		h1 {
			font-size: 30px;
		}
		.about-grid {
			grid-template-columns: 1fr;
		}
		.about-card,
		.editorial-box,
		.cta-box {
			padding: 24px;
		}
	}
</style>
