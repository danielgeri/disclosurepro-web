---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const downloadTitle = `Download DisclosurePro AI — Real Estate Disclosure & Inspection Analyzer`;
const downloadDescription =
	'Download DisclosurePro AI on Google Play or request instant iOS & Web access. Scan 100+ page seller disclosures, home inspections, and HOA documents in seconds — 1st property report free.';

const appSchema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'DisclosurePro AI',
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Android, iOS, Web',
	downloadUrl: 'https://play.google.com/store/apps/details?id=ai.disclosurepro.app',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
		description: 'Free plan includes 1 full property disclosure analysis per month.',
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={downloadTitle} description={downloadDescription} jsonLd={appSchema} />
	</head>
	<body>
		<Header />
		<main>
			<section class="download-page-section">
				<div class="container">
					<div class="glass-card download-card text-center">
						<div class="badge-tech" style="margin-bottom: 16px;">
							<span>🚀 1st Property Analysis Free Every Month</span>
						</div>
						<h1 class="hero-title">Analyze Disclosures with <span class="gradient-text">DisclosurePro AI</span></h1>
						<p class="hero-subtitle">
							Upload 100+ page seller disclosure packets, home inspection PDFs, WDO termite reports, and HOA reserve studies. Get risk scores, PDF page citations, and repair credit estimates in seconds.
						</p>

						<div class="store-buttons">
							<a
								href="https://play.google.com/store/apps/details?id=ai.disclosurepro.app"
								target="_blank"
								rel="noopener noreferrer"
								class="store-btn primary-store"
								data-gtag-event="play_store_click"
								data-gtag-label="download_page_google_play"
							>
								<div class="store-icon" aria-hidden="true">▶️</div>
								<div class="store-text">
									<span class="store-sub">AVAILABLE NOW ON</span>
									<span class="store-title">Google Play</span>
								</div>
							</a>

							<a
								href="mailto:contact@disclosurepro.ai?subject=iOS%20%26%20Web%20Early%20Access%20Invite&body=Hi%20DisclosurePro%20team%2C%0A%0APlease%20send%20me%20an%20invite%20for%20iOS%20%2F%20Desktop%20Web%20access!"
								class="store-btn"
								data-gtag-event="early_access_click"
								data-gtag-label="download_page_ios_web_invite"
							>
								<div class="store-icon" aria-hidden="true">🍏</div>
								<div class="store-text">
									<span class="store-sub">iPHONE &amp; DESKTOP WEB</span>
									<span class="store-title">Request Instant Invite</span>
								</div>
							</a>
						</div>

						<p class="platform-note">
							On iPhone or reviewing a PDF on your laptop? Click <strong>Request Instant Invite</strong> above and we'll get you set up with TestFlight / Web access right away.
						</p>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.download-page-section {
		padding: 90px 0;
		min-height: calc(100vh - 380px);
		display: flex;
		align-items: center;
	}
	.download-card {
		padding: 56px 40px;
		max-width: 820px;
		margin: 0 auto;
	}
	.text-center {
		text-align: center;
	}
	.hero-title {
		font-size: 42px;
		font-weight: 900;
		line-height: 1.15;
		margin-bottom: 16px;
		letter-spacing: -1px;
		text-wrap: balance;
	}
	.hero-subtitle {
		color: var(--text-secondary);
		font-size: 18px;
		line-height: 1.6;
		max-width: 640px;
		margin: 0 auto 36px auto;
		text-wrap: pretty;
	}
	.store-buttons {
		display: flex;
		justify-content: center;
		gap: 20px;
		flex-wrap: wrap;
	}
	.store-btn {
		display: flex;
		align-items: center;
		gap: 14px;
		background: rgba(0, 0, 0, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.22);
		padding: 14px 26px;
		border-radius: 14px;
		text-decoration: none;
		color: #ffffff;
		transition: all 0.2s ease;
	}
	.store-btn.primary-store {
		border-color: var(--accent-cyan);
		box-shadow: 0 6px 24px rgba(28, 227, 237, 0.22);
	}
	.store-btn:hover {
		transform: translateY(-2px);
		border-color: var(--accent-cyan);
		box-shadow: 0 10px 28px rgba(28, 227, 237, 0.3);
		color: #ffffff;
	}
	.store-icon {
		font-size: 28px;
	}
	.store-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.store-sub {
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.6px;
		opacity: 0.85;
	}
	.store-title {
		font-size: 19px;
		font-weight: 700;
		line-height: 1.15;
	}
	.platform-note {
		margin-top: 28px;
		font-size: 13px;
		color: var(--text-secondary);
		max-width: 540px;
		margin-left: auto;
		margin-right: auto;
	}
	.platform-note strong {
		color: var(--text-primary);
	}

	@media (max-width: 600px) {
		.download-card {
			padding: 36px 22px;
		}
		.hero-title {
			font-size: 32px;
		}
		.store-buttons {
			flex-direction: column;
		}
		.store-btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>
